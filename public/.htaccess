# =====================================================================
#  Static export configuration for Hostinger (Apache / LiteSpeed)
#  Upload the CONTENTS of the `out/` folder into `public_html/`.
#  This file is copied into `out/` automatically on every build.
# =====================================================================

Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Force HTTPS: uncomment after SSL is active in hPanel -------------
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- "/" → preferred language ----------------------------------------
  # 1) language previously chosen with the switcher (NEXT_LOCALE cookie)
  # 2) browser language   3) Arabic (default)
  RewriteCond %{HTTP_COOKIE} (^|;\s*)NEXT_LOCALE=en(;|$) [NC]
  RewriteRule ^$ /en/ [R=302,L,E=LOCALE_REDIRECT:1]
  RewriteCond %{HTTP_COOKIE} (^|;\s*)NEXT_LOCALE=ar(;|$) [NC]
  RewriteRule ^$ /ar/ [R=302,L,E=LOCALE_REDIRECT:1]
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^$ /en/ [R=302,L,E=LOCALE_REDIRECT:1]
  RewriteRule ^$ /ar/ [R=302,L,E=LOCALE_REDIRECT:1]

  # --- Unprefixed page URLs (/about, /services/…) → Arabic version ------
  RewriteRule ^(about|services|reviews|videos|articles|contact)(/.*)?$ /ar/$1$2 [R=301,L]

  # --- Directory URLs without a trailing slash → add it (/ar/about → /ar/about/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType text/plain .txt
</IfModule>

<IfModule mod_headers.c>
  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Enable once the whole site is served over HTTPS:
  # Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # The language redirect at "/" depends on the visitor, so it must not be cached.
  Header always set Vary "Accept-Language, Cookie" env=LOCALE_REDIRECT
  Header always set Cache-Control "no-store" env=LOCALE_REDIRECT

  # Fingerprinted build assets (/_next/static/…): cache for a year.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images and icons: cache for 30 days.
  <FilesMatch "\.(jpe?g|png|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Pages, RSC payloads, sitemap: always revalidate so new deployments show immediately.
  <FilesMatch "\.(html|txt|xml|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
