# Public production URL (no trailing slash). Used for canonical URLs, hreflang,
# Open Graph, sitemap.xml and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase project (Dashboard → Project Settings → API Keys). Both are public by design:
# they end up in the browser bundle and access is enforced by RLS (supabase/schema.sql).
# Without them the build falls back to the bundled default content (src/lib/cms/seed.json).
# Never use the service-role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
